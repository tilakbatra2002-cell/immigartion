# ── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# MongoDB Atlas connection string (or self-hosted replica set)
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/immigrationflow
MONGODB_DB_NAME=immigrationflow

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-64-char-random-hex
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-hex
# Dedicated AES-256-GCM key for sensitive PII. Generate with: openssl rand -hex 32
# If unset, a key is derived from JWT_ACCESS_SECRET (dev fallback) — set it in production.
DATA_ENCRYPTION_KEY=replace-with-another-64-char-random-hex

ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_DAYS=7

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=1
# Cookie SameSite. 'lax' (default) works when the SPA and API are on different
# *.vercel.app hostnames. Use 'strict' for a single-origin deployment.
COOKIE_SAME_SITE=lax

# ── Storage ───────────────────────────────────────────────────────────
# local = private disk (dev) | s3 = any S3-compatible bucket (prod: use s3)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── Email (optional) ──────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ImmigrationFlow <no-reply@yourdomain.com>

# ── WhatsApp Cloud API (optional) ─────────────────────────────────────
WHATSAPP_PROVIDER=none
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ── AI (optional, OpenAI-compatible) ──────────────────────────────────
AI_ENABLED=auto
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ── Payments (optional) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PROFESSIONAL=
RAZORPAY_PLAN_BUSINESS=
BILLING_CURRENCY=INR

# ── Limits ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_MAX=12
REQUIRE_EMAIL_VERIFICATION=false
